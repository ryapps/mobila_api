{
  "version": 2,
  "builds": [{ "src": "api/**/*.ts", "use": "@vercel/node" }],
  "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/intent", "dest": "/api/intent.ts" },
    { "src": "/api/decide", "dest": "/api/decide.ts" },
    { "src": "/api/confirm", "dest": "/api/confirm.ts" },
    { "src": "/api/voice", "dest": "/api/voice.ts" },
    { "src": "/api/parse", "dest": "/api/parse.ts" },
    { "src": "/api/health", "dest": "/api/health.ts" },
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" }
  ],
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/parse", "destination": "/api/parse" }
  ]
}
